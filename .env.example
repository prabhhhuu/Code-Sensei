# ── AI Code Tutor — required environment variables ─────────────────────────
# Copy this file to backend/.env (local) or set them in your host's dashboard.
# NEVER commit the real .env — it is git-ignored on purpose.

# Flask session signing key. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Groq API key for the AI analysis features (https://console.groq.com/keys)
GROQ_API_KEY=

# Hugging Face token (read by config.py; optional/unused feature hook)
HF_TOKEN=

# ── Deployment-only (PaaS / Docker) ────────────────────────────────────────
# Directory where ai_tutor.db is created. Point this at a mounted volume so
# the database survives redeploys (e.g. DATABASE_DIR=/data on Railway/Render).
# Leave unset for local dev (defaults to the backend folder).
DATABASE_DIR=
